# Copy this file to .env and fill in your key. .env is gitignored.
#
# Any OpenAI-compatible provider works. Pick one, set the model name, done.
#
#   groq        free tier, no card    llama-3.3-70b-versatile
#   gemini      free tier, no card    gemini-3.8-flash
#   openrouter  free tier, no card    model ids ending in :free
#   mistral     free experiment tier  mistral-large-latest
#   github      free for GitHub users openai/gpt-4o-mini
#   cerebras                          llama-3.3-70b
#   openai      paid                  gpt-4o-mini
#   custom      set XLC_BASE_URL yourself

XLC_PROVIDER=groq
XLC_API_KEY=
XLC_MODEL=llama-3.3-70b-versatile

# Not sure which ids your key can call? Run: xlc models

# Optional. A different judge model reduces self-preference bias; leaving this
# empty makes the model grade its own answers, which the report warns about.
XLC_JUDGE_MODEL=

# --- Throughput -------------------------------------------------------------
#
# XLC_RPM is the ceiling and it comes from your provider, not from this tool.
# Set it to your tier's real limit; the client spreads calls to fit inside it
# instead of hammering the endpoint and collecting 429s.
#
#   Gemini free tier   10-15 rpm   -> a 200-prompt run takes ~13-20 min
#   Groq free tier     ~30 rpm     -> ~7 min
#   paid tiers         hundreds    -> limited by XLC_CONCURRENCY instead
#
# A 429 halves the working budget automatically and a clean streak walks it
# back up, so a wrong value here costs a little discovery time, not a failed run.
# The run prints the rate it settled on.
#
# XLC_CONCURRENCY is how many requests are in flight at once. It removes the
# idle waiting a serial client adds, but it cannot beat the RPM ceiling: if the
# quota is the binding constraint, raising this changes nothing.
#
XLC_RPM=15
XLC_CONCURRENCY=6

XLC_TEMPERATURE=0
XLC_MAX_TOKENS=512
XLC_MAX_RETRIES=5
XLC_TIMEOUT=90

# Left empty on purpose: a system prompt telling the model which language to
# answer in would change the very behaviour being measured.
XLC_SYSTEM_PROMPT=

# Only for XLC_PROVIDER=custom
# XLC_BASE_URL=
